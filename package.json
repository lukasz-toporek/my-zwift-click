{
  "name": "my-zwift-click",
  "version": "0.1.0",
  "description": "Use Zwift Click gear shifters with MyWhoosh and any smart trainer — free, open-source",
  "main": "dist/index.js",
  "bin": {
    "zwift-click": "dist/index.js"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dev:sim": "ts-node src/index.ts --simulate",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@stoprocent/noble": "^2.5.5",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "koffi": "^2.8.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["zwift", "click", "mywhoosh", "ble", "virtual-shifting", "kickr"],
  "license": "MIT"
}
